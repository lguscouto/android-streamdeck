{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://android-streamdeck.local/schemas/v1-profile.schema.json",
  "title": "Perfil de Stream Deck v1",
  "description": "Contrato de um perfil versionado de botoes para o Android Stream Deck.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "id",
    "name",
    "revision",
    "active_page_id",
    "pages"
  ],
  "properties": {
    "protocol_version": {
      "const": 1,
      "description": "Versao do contrato de perfil.",
      "type": "integer"
    },
    "id": {
      "$ref": "#/$defs/stableId",
      "description": "Identificador estavel do perfil."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Revisao monotonicamente crescente do perfil."
    },
    "active_page_id": {
      "$ref": "#/$defs/stableId",
      "description": "ID da pagina ativa; deve existir em pages."
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "ID estavel, sem espacos ou caminhos."
    },
    "keyName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+\\-]{0,31}$"
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "order",
        "rows",
        "columns",
        "buttons"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "buttons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/button"
          }
        }
      }
    },
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "row",
        "column",
        "title",
        "action"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "color": {
          "type": "string",
          "pattern": "^#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
        },
        "action": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "action": {
      "oneOf": [
        {
          "$ref": "#/$defs/hotkeyAction"
        },
        {
          "$ref": "#/$defs/keyAction"
        },
        {
          "$ref": "#/$defs/mediaAction"
        },
        {
          "$ref": "#/$defs/textAction"
        },
        {
          "$ref": "#/$defs/urlAction"
        },
        {
          "$ref": "#/$defs/applicationAction"
        },
        {
          "$ref": "#/$defs/systemInfoAction"
        }
      ]
    },
    "hotkeyAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "modifiers",
        "key"
      ],
      "properties": {
        "type": {
          "const": "hotkey"
        },
        "modifiers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ctrl",
              "alt",
              "shift",
              "win"
            ]
          }
        },
        "key": {
          "$ref": "#/$defs/keyName"
        }
      }
    },
    "keyAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "key"
      ],
      "properties": {
        "type": {
          "const": "key"
        },
        "key": {
          "$ref": "#/$defs/keyName"
        }
      }
    },
    "mediaAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "command"
      ],
      "properties": {
        "type": {
          "const": "media"
        },
        "command": {
          "type": "string",
          "enum": [
            "play_pause",
            "next",
            "previous",
            "stop",
            "volume_up",
            "volume_down",
            "mute"
          ]
        }
      }
    },
    "textAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "urlAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "url"
      ],
      "properties": {
        "type": {
          "const": "url"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?=[A-Za-z0-9.-]{1,253}(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#]|$))[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\s\\\\\\x00-\\x1F\\x7F-\\x9F]*)?$(?![\\s\\S])",
          "maxLength": 2048
        }
      }
    },
    "applicationAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "app_id"
      ],
      "properties": {
        "type": {
          "const": "application"
        },
        "app_id": {
          "$ref": "#/$defs/stableId",
          "description": "ID logico de uma aplicacao registrada no servidor; nao e um caminho."
        }
      }
    },
    "systemInfoAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "const": "system_info"
        },
        "target": {
          "type": "string",
          "enum": [
            "cpu",
            "memory",
            "gpu"
          ]
        }
      }
    }
  }
}
