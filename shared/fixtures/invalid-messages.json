{
  "descricao": "Amostras intencionalmente inválidas; valide cada objeto em mensagens[].message contra v1-message.schema.json.",
  "mensagens": [
    {
      "id": "unknown-type",
      "motivo": "type não pertence ao enum fechado e o payload tenta enviar command livre.",
      "message": {
        "protocol_version": 1,
        "type": "execute_shell",
        "payload": {
          "command": "não-permitido"
        }
      }
    },
    {
      "id": "press-without-button-id",
      "motivo": "press exige request_id, profile_id, page_id, button_id e revision.",
