<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup policy for Android Stream Deck.

  The app persists pairing credentials (access token, private CA pin, internal
  client identity and derived trust metadata) encrypted with
  credential-encrypted storage. allowBackup is false AND these
  rules exclude every domain from both cloud and device-to-device transfer so no
  credential material can cross a backup boundary (Android 12+ device transfer).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>