# Exemplo documental; este arquivo não é carregado automaticamente.
# Não coloque códigos, tokens ou outras credenciais neste arquivo.
STREAMDECK_HOST=127.0.0.1
STREAMDECK_PORT=8765
STREAMDECK_DATABASE_PATH=
# Opcional e apenas para compatibilidade legada; o fluxo recomendado usa uma
# sessão temporária emitida pela janela local.
STREAMDECK_PAIRING_CODE=
# Opcional; habilita inventário/revogação administrativa, separado do pareamento.
STREAMDECK_ADMIN_CODE=
# auto (padrão), required ou disabled. Bind remoto exige required.
STREAMDECK_TLS_MODE=auto
# Diretório externo; vazio usa %LOCALAPPDATA%\AndroidStreamDeck\tls.
STREAMDECK_TLS_STATE_DIR=
# Lista separada por vírgula de SANs usados pelo cliente Android.
STREAMDECK_TLS_IDENTITIES=
# auto (padrão), true ou false. Bind remoto exige true.
STREAMDECK_REQUIRE_AUTH=auto
# Descoberta mDNS: false por padrão; exige bind RFC1918 concreto e autenticação.
STREAMDECK_DISCOVERY_ENABLED=false
# Metadado público do anúncio mDNS. Não use nome pessoal, código, token ou segredo.
STREAMDECK_DISCOVERY_NAME=Android Stream Deck
